{
  "name": "auto-work-analyzer",
  "version": "1.0.0",
  "description": "Automatic work analysis and ClickUp task creation based on git commits",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "analyze": "tsx src/cli.ts",
    "lint": "eslint src",
    "test": "eslint src && bun test && bash scripts/run-nodetests.sh",
    "test:db": "bash scripts/run-nodetests.sh",
    "test:smoke": "tsx src/test.ts",
    "e2e:clickup": "tsx scripts/e2e-clickup.ts",
    "learn:pregenerate-sanskrit-audio": "tsx scripts/pregenerate-sanskrit-audio.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:import": "tsx scripts/import-sqlite-to-postgres.ts",
    "setup": "tsx src/setup.ts",
    "setup-admin": "tsx src/scripts/setup-admin.ts",
    "webhook": "tsx src/webhook-server.ts"
  },
  "bin": {
    "auto-work-analyzer": "./dist/cli.js",
    "awa": "./dist/cli.js"
  },
  "keywords": [
    "git",
    "clickup",
    "automation",
    "work-analysis",
    "task-management",
    "productivity"
  ],
  "author": "Your Name",
  "license": "MIT",
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@vipran/aksharas": "^0.4.0",
    "bcryptjs": "^3.0.2",
    "better-sqlite3": "^12.4.1",
    "commander": "^11.1.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "drizzle-orm": "^0.45.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.1.0",
    "express-validator": "^7.3.0",
    "fastest-levenshtein": "^1.0.16",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "postgres": "^3.4.7",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@indic-transliteration/sanscript": "^1.3.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.13",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.0.0",
    "@types/node": "^20.10.0",
    "drizzle-kit": "^0.31.8",
    "eslint": "^10.8.1",
    "tsx": "^4.6.0",
    "typescript": "^5.3.0",
    "typescript-eslint": "^8.66.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/yourusername/auto-work-analyzer.git"
  },
  "homepage": "https://github.com/yourusername/auto-work-analyzer#readme"
}
