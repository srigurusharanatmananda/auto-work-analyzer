{
  "name": "auto-work-analyzer",
  "version": "1.0.0",
  "description": "Automatic work analysis and ClickUp task creation based on git commits",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "analyze": "tsx src/cli.ts",
    "test": "bun test && tsx --test src/**/*.nodetest.ts",
    "test:db": "tsx --test src/**/*.nodetest.ts",
    "test:smoke": "tsx src/test.ts",
    "setup": "tsx src/setup.ts",
    "setup-admin": "tsx src/scripts/setup-admin.ts",
    "webhook": "tsx src/webhook-server.ts"
  },
  "bin": {
    "auto-work-analyzer": "./dist/cli.js",
    "awa": "./dist/cli.js"
  },
  "keywords": [
    "git",
    "clickup",
    "automation",
    "work-analysis",
    "task-management",
    "productivity"
  ],
  "author": "Your Name",
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.67.0",
    "@google/generative-ai": "^0.24.1",
    "bcryptjs": "^3.0.2",
    "better-sqlite3": "^12.4.1",
    "commander": "^11.1.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.1.0",
    "express-validator": "^7.3.0",
    "fastest-levenshtein": "^1.0.16",
    "helmet": "^7.1.0",
    "joi": "^18.0.1",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "uuid": "^13.0.0",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.13",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.0.0",
    "@types/node": "^20.10.0",
    "tsx": "^4.6.0",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/yourusername/auto-work-analyzer.git"
  },
  "homepage": "https://github.com/yourusername/auto-work-analyzer#readme"
}

















