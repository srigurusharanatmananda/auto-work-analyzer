# ClickUp Configuration
CLICKUP_TEAM_ID=your_team_id_here
CLICKUP_API_KEY=pk_your_api_key_here
CLICKUP_DEFAULT_LIST_ID=your_list_id_here

# Project Configuration
PROJECT_NAME=my-project
PROJECT_DESCRIPTION=Description of your project

# Webhook Configuration (Optional)
WEBHOOK_SECRET=your_webhook_secret_here
WEBHOOK_PORT=3000

# Git Configuration (Optional)
GIT_AUTHOR=developer@example.com
AUTO_ANALYSIS=true

# Analysis Configuration
ANALYSIS_DAYS_BACK=1
COMPLEXITY_THRESHOLD=50
TIME_ESTIMATE_MULTIPLIER=1.0

# Logging
LOG_LEVEL=info
LOG_FILE=logs/auto-work-analyzer.log

# AI API Keys (For manager summaries and AI enhancement features)
# You only need ONE of these - the system will automatically fallback to others if quota is exceeded
# All of these are completely FREE with no credit card required!

# Google Gemini API (60 requests/min free tier)
# Get your key at: https://aistudio.google.com/apikey
GOOGLE_API_KEY=your_google_api_key_here

# Groq API (1000 requests/day, ultra-fast inference)
# Get your key at: https://console.groq.com/keys
GROQ_API_KEY=

# Hugging Face API (Free inference API)
# Get your key at: https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=

# OpenRouter API (Free tier with multiple models)
# Get your key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=


















