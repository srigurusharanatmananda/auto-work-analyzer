# Credential encryption (REQUIRED — the server refuses to start without it)
# Encrypts the ClickUp API keys stored against each saved destination.
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CREDENTIAL_ENCRYPTION_KEY=

# Postgres (REQUIRED). Every store reads it; the server refuses to start if it
# cannot connect. SQLite is gone from the running application — `.database/` is
# now only a migration source.
#
#   bun run db:migrate                       apply schema migrations
#   DATABASE_URL=... bun run db:import       one-shot copy of .database/*.db
#   bun run test:db                          the database suite needs a server
#
# Deliberately has no default: a command that silently targets some fallback
# database is how a migration gets generated against the wrong schema.
DATABASE_URL=postgres://localhost:5432/auto_work_analyzer

# Optional. The database suite creates a throwaway schema per test file; point
# it somewhere other than DATABASE_URL if you would rather it not touch your
# development database.
# TEST_DATABASE_URL=postgres://localhost:5432/auto_work_analyzer_test

# ClickUp Configuration (the fallback destination, used when a request names none)
CLICKUP_TEAM_ID=your_team_id_here
CLICKUP_API_KEY=pk_your_api_key_here
CLICKUP_DEFAULT_LIST_ID=your_list_id_here

# Project Configuration
PROJECT_NAME=my-project
PROJECT_DESCRIPTION=Description of your project

# Webhook Configuration (Optional)
#
# WEBHOOK_SECRET gates POST /api/webhook, which has no user session and creates
# real ClickUp tasks. Leaving it unset does not open the endpoint — it disables
# it (503), because an unfinished configuration is not consent. Set it to a
# random string of 16+ characters if you want CI or git hooks to call it.
WEBHOOK_SECRET=your_webhook_secret_here
WEBHOOK_PORT=3000

# Git Configuration (Optional)
GIT_AUTHOR=developer@example.com
AUTO_ANALYSIS=true

# Analysis Configuration
ANALYSIS_DAYS_BACK=1
COMPLEXITY_THRESHOLD=50
TIME_ESTIMATE_MULTIPLIER=1.0

# Logging
LOG_LEVEL=info
LOG_FILE=logs/auto-work-analyzer.log

# AI API Keys (For manager summaries and AI enhancement features)
# You only need ONE of these - the system will automatically fallback to others if quota is exceeded
# All of these are completely FREE with no credit card required!

# Google Gemini API (60 requests/min free tier)
# Get your key at: https://aistudio.google.com/apikey
GOOGLE_API_KEY=your_google_api_key_here

# Groq API (1000 requests/day, ultra-fast inference)
# Get your key at: https://console.groq.com/keys
GROQ_API_KEY=

# Hugging Face API (Free inference API)
# Get your key at: https://huggingface.co/settings/tokens
#
# Also required to run services/tts (the self-hosted Indic Parler-TTS
# service Sanskrit speech generation needs): ai4bharat/indic-parler-tts is a
# GATED model, so this token's account must have visited
# https://huggingface.co/ai4bharat/indic-parler-tts and accepted access
# there FIRST — a token from an account that hasn't cannot download it,
# regardless of the token's own permissions. Passed to that container as
# HF_TOKEN via docker-compose.yml.
HUGGINGFACE_API_KEY=

# OpenRouter API (Free tier with multiple models)
# Get your key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=



















# Commit grouping. AI grouping is used automatically when a provider key above
# is present; set this to false to force the keyword heuristic instead.
AI_GROUPING=true

# The org-wide daily repo scan is configured in the app, not here:
# Settings -> Daily Repo Scan (/settings/scanning). It needs no GitHub token —
# organisation membership comes from each local clone git remote.

# ---- Transcription (audio -> transcript) ----
# All optional; transcription simply stays unavailable without a running Whisper.

# Where the Whisper service listens. Matches docker-compose.yml.
WHISPER_API_URL=http://localhost:8000

# Host directory bind-mounted into the Whisper container as /storage. MUST match
# the left side of the volume in docker-compose.yml, because Whisper opens the
# audio file itself rather than receiving bytes — a mismatch means nothing can be
# transcribed. The upload route checks this up front and refuses rather than
# queueing work that cannot run.
TRANSCRIPTION_STORAGE_ROOT=./storage

# Ceiling for one transcription. Default 30 min. Measured ~6x realtime with the
# `base` model on an M3, so a 1-hour recording takes roughly 10 minutes.
# WHISPER_TIMEOUT_MS=1800000

# Model size / device, read by docker-compose. `base` fits 8 GB comfortably;
# `small` is better on accented speech and about 3x slower. DEVICE stays `cpu`
# because Docker Desktop on macOS cannot pass through the Apple GPU.
# WHISPER_MODEL=base
# WHISPER_DEVICE=cpu
# WHISPER_COMPUTE_TYPE=int8
